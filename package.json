{
  "name": "@e-roux/pi-plugins",
  "version": "1.0.0",
  "description": "Pi coding agent distribution: development guards, Make-centric workflow, and infrastructure skills",
  "type": "module",
  "keywords": ["pi-package"],
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "author": "Emmanuel Roux",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-roux/agent-plugins.git"
  },
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./plugins/dev/extensions/pi",
      "./plugins/make/extensions/pi",
      "./plugins/infra/extensions/pi"
    ],
    "skills": [
      "./plugins/dev/skills",
      "./plugins/infra/skills",
      "./plugins/make/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@mxhq/agent-plugin-core": "file:packages/core"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.13",
    "@types/node": "^22.0.0"
  }
}
