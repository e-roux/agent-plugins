{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@mxhq/agent-plugin-core": [
        "./packages/core/src/index.ts"
      ],
      "@mxhq/agent-plugin-core/types": [
        "./packages/core/src/types.ts"
      ],
      "@mxhq/agent-plugin-core/utils": [
        "./packages/core/src/utils.ts"
      ],
      "@dev/hooks/*": [
        "./plugins/dev/hooks/src/*"
      ],
      "@dev/skills": [
        "./plugins/dev/skills"
      ],
      "@infra/hooks/*": [
        "./plugins/infra/hooks/src/*"
      ],
      "@infra/skills": [
        "./plugins/infra/skills"
      ]
    }
  },
  "include": [
    "env.d.ts",
    "plugins/**/*.ts",
    "plugins/**/.opencode/**/*.ts",
    "packages/**/*.ts"
  ]
}
