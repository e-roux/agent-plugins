{
  "name": "dev",
  "description": "General-purpose development guards: blocks hardcoded secrets, direct main pushes, destructive SQL migrations, --no-verify bypasses, comment lines in source code, and monitors CI pipeline status after every push. Works with any project.",
  "version": "1.1.0",
  "author": {
    "name": "Emmanuel Roux"
  },
  "license": "MIT",
  "keywords": [
    "development",
    "guards",
    "security",
    "git",
    "migration",
    "secrets",
    "self-documenting",
    "ci",
    "pipeline"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PLUGIN_ROOT/hooks/src/session-start.ts\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PLUGIN_ROOT/hooks/src/pre-tool.ts\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PLUGIN_ROOT/hooks/src/post-tool.ts\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PLUGIN_ROOT/hooks/src/pipeline-chainguard.ts\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v mcp-git-ops >/dev/null 2>&1 || { GOBIN=\"${XDG_BIN_HOME:-$HOME/.local/bin}\" go install \"$CLAUDE_PLUGIN_ROOT/mcp-git-ops\"; }",
            "timeout": 120,
            "statusMessage": "Compiling mcp-git-ops..."
          }
        ]
      }
    ]
  }
}
