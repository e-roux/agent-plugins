{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${extensionPath}/hooks/src/session-start.ts\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${extensionPath}/hooks/src/branch-check-turn.ts\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${extensionPath}/hooks/src/pre-tool.ts\"",
            "name": "dev-guards",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${extensionPath}/hooks/src/post-tool.ts\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${extensionPath}/hooks/src/pipeline-chainguard.ts\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
