{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/session-start.js\"",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmit": [
      {
        "type": "command",
        "bash": "node \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/branch-check-turn.js\"",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/pre-tool.js\"",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/post-tool.js\"",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "node \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/pipeline-chainguard.js\"",
        "timeoutSec": 5
      }
    ]
  }
}
