{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/session-start.js\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/branch-check-turn.js\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/pre-tool.js\"",
            "name": "dev-guards",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/post-tool.js\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/pipeline-chainguard.js\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}