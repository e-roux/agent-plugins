{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/session-start.js\"",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/hooks/scripts/pre-tool.js\"",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}