#!/usr/bin/env bash
set -euo pipefail

# Validate Node.js runtime (required for --experimental-strip-types)
if ! command -v node >/dev/null 2>&1; then
  printf "\n\033[1;31m[REJECTED]\033[0m Node.js is not installed or not in PATH.\n"
  printf "Hooks require Node.js >= 22.6.0 (for --experimental-strip-types).\n\n"
  exit 1
fi

node_major=$(node -e "process.stdout.write(String(process.versions.node.split('.')[0]))")
node_minor=$(node -e "process.stdout.write(String(process.versions.node.split('.')[1]))")
if [ "$node_major" -lt 22 ] || { [ "$node_major" -eq 22 ] && [ "$node_minor" -lt 6 ]; }; then
  printf "\n\033[1;31m[REJECTED]\033[0m Node.js %s.%s is too old.\n" "$node_major" "$node_minor"
  printf "Hooks require Node.js >= 22.6.0 (for --experimental-strip-types).\n\n"
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_ref" =~ ^refs/tags/(.*)$ ]]; then
    tag="${BASH_REMATCH[1]}"
    
    if [[ "$tag" =~ ^dev/ || "$tag" =~ ^v[0-9] ]]; then
      binary_path="plugins/dev/mcp-git-ops/mcp-git-ops"
      if [ ! -f "$binary_path" ]; then
        printf "\n\033[1;31m[REJECTED]\033[0m Pushing tag '%s' is blocked because the compiled MCP server binary is missing.\n" "$tag"
        printf "Please compile the binary first (e.g. run 'make build' inside plugins/dev/mcp-git-ops) before pushing this tag.\n\n"
        exit 1
      fi
    fi
  fi
done

exit 0
