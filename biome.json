{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "plugins/**/plugin.json",
      "plugins/**/package.json",
      "plugins/**/copilot.json",
      "plugins/**/hooks.json",
      "plugins/**/.claude-plugin/plugin.json",
      "marketplace.json",
      ".claude-plugin/marketplace.json"
    ],
    "ignoreUnknown": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "trailingNewline": true
  },
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    },
    "formatter": {
      "trailingCommas": "none",
      "expand": "always"
    },
    "linter": {
      "enabled": false
    },
    "assist": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
